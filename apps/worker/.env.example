# Copy to `.env` and adjust. `bun run dev:stack` provides the services
# these point at.
#
# APP_KEY and DATABASE_URL must be IDENTICAL in apps/web/.env and
# apps/worker/.env: the worker encrypts SSH keys and environment variables
# that the web then reads back. Two different keys do not fail at startup —
# they fail the first time a secret is read. `verify-compose` checks that
# these two files agree.

# Development only, and deliberately readable as such. Production never sees
# this value: `install.sh` draws its own with `openssl rand -base64 32`.
APP_KEY=ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=

DATABASE_URL=postgres://noddle:noddle@localhost:55432/noddle
REDIS_URL=redis://localhost:56379

# Where the worker WRITES build logs. Must match the web's.
LOG_ROOT=.noddle/logs

# The overlay network Traefik watches on the target server. Unset, the worker
# uses `noddle-public` — the same name `spike-local.sh` creates on the VM.
# TRAEFIK_NETWORK=noddle-public

# Set only when a domain is configured. Without a name no certificate is
# possible and deployed apps go out over HTTP — which is the local case.
# CERT_RESOLVER=

# Absent, the worker falls back to a local build with the service pinned to
# its node. A local VM has no registry, so leave these unset.
# REGISTRY_HOST=
# REGISTRY_PASSWORD=
