{
  "name": "noddle",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@aws-sdk/client-s3": "^3.1102.0",
      "@aws-sdk/lib-storage": "^3.1102.0",
      "@tanstack/react-query": "^5.101.4",
      "@tanstack/react-router": "^1.170.18",
      "@tanstack/react-start": "^1.168.34",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/charts": "^0.6.4",
      "@tanstack/react-charts": "^0.6.4",
      "@tanstack/react-form": "^1.33.4",
      "@tanstack/react-table": "^9.2.4",
      "@types/bun": "^1.4.2",
      "@types/d3-scale": "^4.0.9",
      "@types/dockerode": "^4.0.1",
      "@types/node": "^26.1.2",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@types/ssh2": "^1.15.5",
      "@vitejs/plugin-react": "^6.0.5",
      "better-auth": "^1.7.3",
      "d3-scale": "^4.0.2",
      "bullmq": "^6.0.5",
      "dockerode": "^5.0.1",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "ioredis": "^6.0.0",
      "postgres": "^3.4.9",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "ssh2": "^1.17.0",
      "tailwindcss": "^4.3.3",
      "typescript": "7.0.2",
      "ultracite": "7.12.2",
      "vite": "^8.2.0",
      "yaml": "^2.9.0",
      "zod": "^4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "dev": "bun run scripts/dev-preflight.ts && bun run dev:stack && bun run --cwd packages/db migrate && vp run -r dev",
    "dev:stack": "docker compose -f compose.dev.yml up -d --wait && bun run packages/testing/src/seed-stack.ts",
    "dev:stack:down": "docker compose -f compose.dev.yml down",
    "dev:stack:reset": "docker compose -f compose.dev.yml down -v && bun run dev:stack && bun run --cwd packages/db migrate && bun run scripts/dev-adopt-notice.ts",
    "fix": "ultracite fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/dashboard",
    "verify:local": "vp run -r --concurrency-limit 1 verify:local",
    "verify:pure": "vp run -r verify:pure",
    "verify:vm": "vp run -r --concurrency-limit 1 verify:vm"
  },
  "devDependencies": {
    "@noddle/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "vite-plus": "^1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.2",
      "onFail": "warn"
    }
  }
}
